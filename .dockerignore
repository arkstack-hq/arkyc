# Keep the build context small: source + manifests only. Everything generated or
# secret is regenerated inside the image or injected at runtime.

# Dependencies + build output (reinstalled/rebuilt in the image).
**/node_modules
**/dist
**/build
**/.turbo

# Framework-generated state (regenerated by prepare / ark build / ark migrate).
apps/api/.arkstack
apps/api/.arkormx

# VCS + CI + editor.
.git
.github
.vscode
.idea

# Secrets + local env (injected via compose/environment, never baked in).
**/.env
**/.env.*
!**/.env.example

# Tests, coverage, logs, tmp.
**/coverage
**/*.log
**/.DS_Store
scratchpad

# Docker artifacts themselves.
Dockerfile
.dockerignore
docker-compose*.yml

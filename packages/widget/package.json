{
  "name": "@arkyc/widget",
  "version": "1.2.6",
  "description": "Embeddable, framework-agnostic Arkyc identity-verification widget",
  "license": "MIT",
  "keywords": [
    "arkyc",
    "kyc",
    "identity-verification",
    "identity",
    "verification",
    "widget",
    "embed",
    "document-capture",
    "liveness",
    "browser"
  ],
  "homepage": "https://docs.arkyc.toneflix.net",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arkstack-hq/arkyc.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/arkstack-hq/arkyc/issues"
  },
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./standalone": "./dist/arkyc-widget.iife.global.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:standalone": "tsdown -c tsdown.iife.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arkyc/types": "workspace:^",
    "qrcode-generator": "^1.4.4"
  },
  "peerDependencies": {
    "firebase": "^11.0.0",
    "pusher-js": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    },
    "pusher-js": {
      "optional": true
    }
  }
}

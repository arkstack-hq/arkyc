{
  "name": "@arkyc/sdk",
  "version": "1.1.0",
  "description": "Arkyc TypeScript SDK (server + browser)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./browser": {
      "types": "./dist/browser.d.mts",
      "import": "./dist/browser.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@arkyc/types": "workspace:^",
    "@arkyc/core": "workspace:^",
    "@arkyc/webhooks": "workspace:^"
  }
}

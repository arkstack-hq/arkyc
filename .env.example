# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgres://arkyc:arkyc@localhost:5432/arkyc
DB_HOST=localhost
DB_PORT=5432
DB_USER=arkyc
DB_PASSWORD=arkyc
DB_NAME=arkyc

# ── Auth / crypto ────────────────────────────────────────────────────────────
APP_KEY=change-me-32-byte-secret-key-please
JWT_SECRET=change-me-jwt-secret
CLIENT_TOKEN_TTL_SECONDS=900

# ── Storage ──────────────────────────────────────────────────────────────────
# Drivers: local | s3-compatible | cloudflare-r2
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=arkyc
S3_ACCESS_KEY_ID=arkyc
S3_SECRET_ACCESS_KEY=arkyc-secret
S3_FORCE_PATH_STYLE=true

# ── Providers ────────────────────────────────────────────────────────────────
# Drivers: mock | tesseract | external
OCR_DRIVER=mock
# Drivers: mock | internal | external
LIVENESS_DRIVER=mock
# Drivers: mock | internal | external
FACE_MATCH_DRIVER=mock

# ── Queue & Cache (@arkstack/queue + @arkstack/cache) ────────────────────────
# Queue connection: sync (inline; dev/test default), database, or redis.
QUEUE_CONNECTION=sync
# Cache store: memory (default), file, redis, or database.
CACHE_STORE=memory
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_SIGNING_ALGORITHM=sha256

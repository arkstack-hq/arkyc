APP_NAME=Arkyc
APP_URL=http://localhost:3100
APP_PORT=3100
APP_HOST=localhost
# Dashboard origin. Also hosts the cross-device handoff page (`/verify`), so the
# QR the widget shows points at `${FRONTEND_URL}/verify`.
FRONTEND_URL=http://localhost:3000

APP_KEY=
JWT_EXPIRES_IN=1h

NGROK_AUTHTOKEN=27xhQce3nekwcJvZ4WpHWIra7k1_2ky5NacPPQapJr9gmVHGd

DATABASE_URL=postgres://postgres:postgres@localhost:5432/arkstark_test?schema=public

MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=password
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_TEST_ADDRESS=

# Async work (@arkstack/queue + @arkstack/jobs).
# sync = run jobs inline (no worker; dev/test default). database/redis = durable;
# run `ark queue:work <connection> --queue=<ocr|biometric|webhook>`.
QUEUE_CONNECTION=sync

# Cache (@arkstack/cache): memory (default), file, redis, or database.
CACHE_STORE=memory

# OCR driver: mock (fixed demo fields — same for every session), tesseract (real
# in-process OCR via Tesseract.js → the document-parser registry), ai (a vision LLM
# reads the document AND flags best-effort tamper/replay signals — set OCR_API_KEY),
# or external (point OCR_ENDPOINT/OCR_API_KEY
# at an OCR HTTP service). Use `tesseract`/`ai` for real extraction; `mock` is only
# for dev/tests. For sharper `tesseract` results, also install `sharp`
# (pnpm add sharp -F @arkyc/ocr) — it auto-enables a grayscale/normalise/upscale
# preprocessing pass; without it OCR runs on the raw image.
OCR_DRIVER=mock
# OCR_LANGUAGE=eng
# Fallback OCR driver used when the primary is `ai` but a project isn't granted
# AI processing (project owners request it, admins grant/revoke). Defaults to
# `mock`; set a real driver (e.g. `tesseract`) in production so ungranted
# projects still get genuine extraction rather than fixed demo fields.
OCR_FALLBACK_DRIVER=mock
# AI OCR driver (OCR_DRIVER=ai): Anthropic API key + optional model/base/image cap.
# `sharp` (optional) downsizes the upload to OCR_AI_MAX_EDGE px to cut token cost.
# OCR_API_KEY=sk-ant-...
# OCR_AI_MODEL=claude-haiku-4-5-20251001
# OCR_AI_MAX_EDGE=1568
# OCR_ENDPOINT=https://api.anthropic.com
# Liveness / face-match drivers: mock (default) or external (set the matching *_ENDPOINT).
LIVENESS_DRIVER=mock
FACE_MATCH_DRIVER=mock

# Redis (for the redis queue/cache connections).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Realtime. The active transport is chosen by the platform
# `realtime.transport` setting; this env is the fallback when it is `off`.
# `memory` is a dev/test-only hard override. Options: off | pusher | firebase | memory.
REALTIME_TRANSPORT=off

# Pusher. Defaults to hosted Pusher Channels (set PUSHER_CLUSTER to your cluster,
# e.g. eu/us2). To use the self-hosted soketi from docker-compose instead, set
# PUSHER_HOST=127.0.0.1 (TLS then defaults off).
PUSHER_APP_ID=arkyc
PUSHER_APP_KEY=arkyc-key
PUSHER_APP_SECRET=arkyc-secret
PUSHER_CLUSTER=mt1
# PUSHER_HOST=127.0.0.1
# PUSHER_PORT=6001
# PUSHER_USE_TLS=true

# Firebase (Realtime Database). Service-account creds + public web config.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

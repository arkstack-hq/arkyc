APP_NAME="Arkstack"
APP_URL="http://localhost:3100"
APP_PORT=3100
APP_HOST=localhost

APP_KEY=
JWT_EXPIRES_IN="1h"

DATABASE_URL="postgres://postgres:postgres@localhost:5432/arkstark_test?schema=public"

MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME="no-reply@example.com"
MAIL_PASSWORD="password"
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_TEST_ADDRESS=

# Async work (@arkstack/queue + @arkstack/jobs).
# sync = run jobs inline (no worker; dev/test default). database/redis = durable;
# run `ark queue:work <connection> --queue=<ocr|biometric|webhook>`.
QUEUE_CONNECTION=sync

# Cache (@arkstack/cache): memory (default), file, redis, or database.
CACHE_STORE=memory

# Provider drivers: mock (default) or external (set the matching *_ENDPOINT).
OCR_DRIVER=mock
LIVENESS_DRIVER=mock
FACE_MATCH_DRIVER=mock

# Redis (for the redis queue/cache connections).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Realtime. The active transport is chosen by the platform
# `realtime.transport` setting; this env is the fallback when it is `off`.
# `memory` is a dev/test-only hard override. Options: off | pusher | firebase | memory.
REALTIME_TRANSPORT=off

# Pusher. Defaults to hosted Pusher Channels (set PUSHER_CLUSTER to your cluster,
# e.g. eu/us2). To use the self-hosted soketi from docker-compose instead, set
# PUSHER_HOST=127.0.0.1 (TLS then defaults off).
PUSHER_APP_ID=arkyc
PUSHER_APP_KEY=arkyc-key
PUSHER_APP_SECRET=arkyc-secret
PUSHER_CLUSTER=mt1
# PUSHER_HOST=127.0.0.1
# PUSHER_PORT=6001
# PUSHER_USE_TLS=true

# Firebase (Realtime Database). Service-account creds + public web config.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

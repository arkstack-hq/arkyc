APP_NAME="Arkstack"
APP_URL="http://localhost:3100"
APP_PORT=3100
APP_HOST=localhost

TWO_FACTOR_ENCRYPTION_KEY="SRNysvjD139E6hrZfS8If7pQi0Uv/2ZBXb6fAT+agDZNpbfIAnVyHHvholN9c74v"
JWT_SECRET="your-jwt-secret"
JWT_EXPIRES_IN="1h"

DATABASE_URL="postgres://postgres:postgres@localhost:5432/arkstark_test?schema=public"

MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME="no-reply@example.com"
MAIL_PASSWORD="password"
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_TEST_ADDRESS=

# Async work (@arkstack/queue + @arkstack/jobs).
# sync = run jobs inline (no worker; dev/test default). database/redis = durable;
# run `ark queue:work <connection> --queue=<ocr|biometric|webhook>`.
QUEUE_CONNECTION=sync

# Cache (@arkstack/cache): memory (default), file, redis, or database.
CACHE_STORE=memory

# Provider drivers: mock (default) or external (set the matching *_ENDPOINT).
OCR_DRIVER=mock
LIVENESS_DRIVER=mock
FACE_MATCH_DRIVER=mock

# Redis (for the redis queue/cache connections).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Realtime (Phase 16). The active transport is chosen by the platform
# `realtime.transport` setting; this env is the fallback when it is `off`.
# `memory` is a dev/test-only hard override. Options: off | soketi | firebase | memory.
REALTIME_TRANSPORT=off

# Soketi (Pusher-compatible) — matches docker-compose defaults.
SOKETI_APP_ID=arkyc
SOKETI_APP_KEY=arkyc-key
SOKETI_APP_SECRET=arkyc-secret
SOKETI_HOST=127.0.0.1
SOKETI_PORT=6001
SOKETI_USE_TLS=false

# Firebase (Realtime Database). Service-account creds + public web config.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

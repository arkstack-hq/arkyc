# [App]
APP_NAME=Arkyc
APP_URL=http://localhost:3100
APP_PORT=3100
APP_HOST=localhost
FRONTEND_URL=http://localhost:3000
WEBSITE_URL=http://localhost:3000
APP_KEY=
JWT_EXPIRES_IN=1h
# TRUST_PROXY=1
# NGROK_AUTHTOKEN=

# [Database]
DATABASE_URL=postgres://postgres:postgres@localhost:5432/arkstark_test?schema=public

# [Mail]
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=password
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_TEST_ADDRESS=

# [Queue] sync | database | redis
QUEUE_CONNECTION=sync
# Queue each job kind is dispatched onto. Every queue needs a worker: one
# `ark queue:work --queue=<name>` per name, or a single
# `ark queue:work '--queue=webhook,*'` working them all. Otherwise those jobs are
# queued but never processed.
QUEUE_NAME_OCR=ocr
QUEUE_NAME_BIOMETRIC=biometric
QUEUE_NAME_WEBHOOK=webhook
QUEUE_NAME_MAINTENANCE=maintenance
QUEUE_NAME_NOTIFICATIONS=notifications

# [Session sweep] schedule | queue | off
SESSION_SWEEP_DRIVER=schedule
SESSION_SWEEP_INTERVAL=300

# [Cache] memory | file | redis | database
CACHE_STORE=memory

# [Redis]
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# [OCR] mock | tesseract | ai | external
OCR_DRIVER=mock
OCR_FALLBACK_DRIVER=mock
# OCR_LANGUAGE=eng
# OCR_ENDPOINT=https://api.anthropic.com
# OCR_API_KEY=
# OCR_AI_MODEL=claude-haiku-4-5-20251001
# OCR_AI_MAX_EDGE=1568

# [OCR on Cloudflare Workers AI]
# OCR_AI_PROVIDER=workers-ai
# WORKERS_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# [Liveness and face match] mock | external | local
LIVENESS_DRIVER=mock
FACE_MATCH_DRIVER=mock
# LIVENESS_ENDPOINT=
# LIVENESS_API_KEY=
# FACE_MATCH_ENDPOINT=
# FACE_MATCH_API_KEY=
# BIOMETRICS_MODEL_DIR=storage/models

# [Address] mock | live
ADDRESS_DRIVER=mock
# ADDRESS_ORS_API_KEY=
# ADDRESS_ORS_URL=https://api.openrouteservice.org/geocode/search
# ADDRESS_NOMINATIM_URL=https://nominatim.openstreetmap.org
# ADDRESS_USER_AGENT=Arkyc/1.0 (address-verification)

# [Screening] mock | opensanctions | external
SCREENING_DRIVER=mock
# SCREENING_API_KEY=
# SCREENING_ENDPOINT=https://api.opensanctions.org
# SCREENING_DATASET=default
# SCREENING_MONITOR_INTERVAL_HOURS=24

# [Network] mock | maxmind
NETWORK_DRIVER=mock
# MAXMIND_COUNTRY_DB=storage/geoip/GeoLite2-Country.mmdb
# MAXMIND_ASN_DB=storage/geoip/GeoLite2-ASN.mmdb
# MAXMIND_ANONYMOUS_IP_DB=
# TOR_EXIT_LIST=

# [Realtime] pusher | firebase | firebase-database | polling | memory
REALTIME_TRANSPORT=polling
REALTIME_POLL_INTERVAL=5000

# [Push] firebase | false
REALTIME_PUSH=false

# [Pusher]
PUSHER_APP_ID=arkyc
PUSHER_KEY=arkyc-key
PUSHER_SECRET=arkyc-secret
PUSHER_CLUSTER=mt1
# PUSHER_HOST=127.0.0.1
# PUSHER_PORT=6001
# PUSHER_USE_TLS=false
# PUSHER_PUBLIC_HOST=localhost
# PUSHER_PUBLIC_PORT=6001
# PUSHER_PUBLIC_USE_TLS=false

# [Firebase]
# FIREBASE_ADMINSDK=storage/app/firebase-adminsdk.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=

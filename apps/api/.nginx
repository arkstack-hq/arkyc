# Proxies all requests to the local Express process.
# automatically via:  include /var/www/server-config-path/.ngin*;
#
# NOTE: do NOT add a `location /.well-known/acme-challenge/` here. Control panels
# like TinyCP already define that location in the generated vhost to serve ACME
# HTTP-01 challenges, and a second copy makes nginx fail to start with
# "duplicate location". If you run raw nginx + certbot WITHOUT a panel that
# provides it, add such a location (served from the docroot) so cert issuance
# isn't swallowed by the proxy below.

location / {
    proxy_pass         http://127.0.0.1:3100;
    proxy_http_version 1.1;

    # Required for keep-alive / WebSocket upgrade if you ever need it
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection 'upgrade';

    # Forward real client info to Express (req.ip, req.hostname, etc.)
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_cache_bypass $http_upgrade;
}

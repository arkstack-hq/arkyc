// Cloudflare Workers deploy for the Arkyc marketing site + docs (prerendered by vite-react-ssg).
// An assets-only Worker: `pnpm build` emits ./dist and `wrangler deploy` uploads
// it; unknown paths fall back to index.html so client-side routes resolve.
// VITE_* values are baked in at build time, so set them before building
// (see .github/workflows/deploy-cloudflare.yml).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arkyc-website",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  // Serve on the production domain once its DNS is on Cloudflare (the zone must
  // be in the same account; wrangler creates the DNS record and certificate).
  // Until then the Worker answers on its workers.dev subdomain.
  // "routes": [
  //   { "pattern": "arkyc.toneflix.net", "custom_domain": true },
  //   { "pattern": "www.arkyc.toneflix.net", "custom_domain": true }
  // ],
  "env": {
    // `wrangler deploy --env staging` → arkyc-website-staging on workers.dev.
    "staging": {
      "name": "arkyc-website-staging",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
  },
}

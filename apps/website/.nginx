# Static single-page app (React Router) served by nginx from this site's docroot.
# Includes this file into the site's server block via:
#   include /var/www/<domain>/.ngin*;
# point `root` at the docroot using the vhost config, so we only add locations here.

# Long-cache the content-hashed Vite build assets.
location /assets/ {
    access_log off;
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
}

# SPA fallback: hand client-side routes back to index.html.
location / {
    try_files $uri $uri/ /index.html;
}

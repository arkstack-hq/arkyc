# Project secret API key (sk_…). Minted in the dashboard (Project → API keys)
# or seeded by DemoTenantSeeder. Stays server-side — never shipped to the browser.
ARKYC_SECRET_KEY=

# Base URL of the running Arkyc API (apps/api). Defaults to the dev port.
ARKYC_API_URL=http://localhost:3100

# Signing secret of the webhook endpoint you point at this playground
# (Project → Webhooks → add endpoint → http://localhost:5174/pg/webhooks/arkyc).
# Shown once at creation. Leave blank to accept deliveries unverified.
ARKYC_WEBHOOK_SECRET=

# Port for this playground dev server.
PORT=5174
